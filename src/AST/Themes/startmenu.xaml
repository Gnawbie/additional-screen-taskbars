<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource Menu.Back}" TextElement.Foreground="{DynamicResource Menu.Text}"
      TextElement.FontFamily="Segoe UI" TextElement.FontSize="13">
  <Grid.Resources>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8" />
      <Setter Property="MinWidth" Value="8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="{DynamicResource Menu.Dim}" CornerRadius="3" Margin="1,0" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RailButton" TargetType="Button">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="{DynamicResource Menu.Text}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Back" Background="Transparent" Height="48">
              <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource Menu.Hover}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PinButton" TargetType="Button">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Foreground" Value="{DynamicResource Menu.Text}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Back" Background="Transparent" Padding="12,6">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource Menu.Hover}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>
  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="48" />
    <ColumnDefinition Width="240" />
    <ColumnDefinition Width="*" />
  </Grid.ColumnDefinitions>

  <!-- The buttons down the left edge. -->
  <DockPanel Background="{DynamicResource Menu.Panel}">
    <StackPanel DockPanel.Dock="Bottom">
      <Button x:Name="UserButton" Style="{StaticResource RailButton}" Content="&#xE77B;" />
      <Button x:Name="DocumentsButton" Style="{StaticResource RailButton}" Content="&#xE7C3;" ToolTip="Documents" />
      <Button x:Name="PicturesButton" Style="{StaticResource RailButton}" Content="&#xEB9F;" ToolTip="Pictures" />
      <Button x:Name="SettingsButton" Style="{StaticResource RailButton}" Content="&#xE713;" ToolTip="Settings" />
      <Button x:Name="PowerButton" Style="{StaticResource RailButton}" Content="&#xE7E8;" ToolTip="Power" />
    </StackPanel>
    <Border />
  </DockPanel>

  <!-- Pinned programs, with search at the bottom. -->
  <DockPanel Grid.Column="1" Background="{DynamicResource Menu.Panel}">
    <Border DockPanel.Dock="Bottom" Margin="8" Background="{DynamicResource Menu.Tile}">
      <Grid>
        <TextBlock x:Name="SearchHint" Text="Type to search" Foreground="{DynamicResource Menu.Dim}" Margin="9,6" IsHitTestVisible="False" />
        <TextBox x:Name="Search" Background="Transparent" BorderThickness="0" Padding="6,6" Foreground="{DynamicResource Menu.Text}" CaretBrush="{DynamicResource Menu.Text}" />
      </Grid>
    </Border>
    <Grid>
      <TextBlock x:Name="PinsHint" Text="Right-click a program and choose Pin to Start to add it here." TextWrapping="Wrap"
                 Foreground="{DynamicResource Menu.Dim}" Margin="14" VerticalAlignment="Bottom" />
      <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
        <StackPanel x:Name="Pins" AllowDrop="True" Background="Transparent" />
      </ScrollViewer>
    </Grid>
  </DockPanel>

  <!-- The app list. -->
  <DockPanel Grid.Column="2">
    <ListBox x:Name="Apps" Margin="0,6,0,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Menu.Text}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel">
      <ListBox.GroupStyle>
        <GroupStyle>
          <GroupStyle.HeaderTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" Margin="10,10,0,4" FontWeight="SemiBold" Foreground="{DynamicResource Menu.Dim}" />
            </DataTemplate>
          </GroupStyle.HeaderTemplate>
        </GroupStyle>
      </ListBox.GroupStyle>
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="Focusable" Value="False" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Back" Background="Transparent" Padding="10,5">
                  <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Back" Property="Background" Value="{DynamicResource Menu.Hover}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <DockPanel>
            <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="Fant" />
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Grid>
