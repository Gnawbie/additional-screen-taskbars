<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:eb="clr-namespace:AST;assembly=AST">

  <!-- The grey, bevelled look of classic Windows. -->
  <BooleanToVisibilityConverter x:Key="BoolToVisible" />
  <SolidColorBrush x:Key="Face" Color="#C0C0C0" />
  <SolidColorBrush x:Key="Light" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Shadow" Color="#808080" />
  <SolidColorBrush x:Key="Dark" Color="#000000" />

  <!-- Raised when idle, pressed in while active or held down. -->
  <Style x:Key="ClassicButton" TargetType="Button">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Foreground" Value="Black" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Outer" BorderThickness="0,0,1,1" BorderBrush="{StaticResource Dark}" Margin="1,2">
            <Border x:Name="Inner" BorderThickness="1,1,1,1" BorderBrush="{StaticResource Light}" Background="{StaticResource Face}">
              <ContentPresenter x:Name="Body" Margin="3,1" VerticalAlignment="Center" />
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Outer" Property="BorderThickness" Value="1,1,0,0" />
              <Setter TargetName="Inner" Property="BorderBrush" Value="{StaticResource Shadow}" />
              <Setter TargetName="Body" Property="Margin" Value="4,2,2,0" />
            </Trigger>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
              <Setter TargetName="Outer" Property="BorderThickness" Value="1,1,0,0" />
              <Setter TargetName="Inner" Property="BorderBrush" Value="{StaticResource Shadow}" />
              <Setter TargetName="Inner" Property="Background" Value="#E8E8E8" />
              <Setter TargetName="Body" Property="Margin" Value="4,2,2,0" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Turns a program's icon and name sideways when the "vertical names" option is on, and centers a lone icon. -->
  <Style x:Key="RotateTaskContent" TargetType="FrameworkElement">
    <Style.Triggers>
      <DataTrigger Binding="{Binding DataContext.ShowLabels, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="False">
        <Setter Property="HorizontalAlignment" Value="Center" />
      </DataTrigger>
      <DataTrigger Binding="{Binding DataContext.RotateLabels, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
        <Setter Property="LayoutTransform">
          <Setter.Value><RotateTransform Angle="90" /></Setter.Value>
        </Setter>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <!-- A thin side bar has no room for an upright Start button. -->
  <Style x:Key="RotateWhenNarrow" TargetType="FrameworkElement">
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsNarrow}" Value="True">
        <Setter Property="LayoutTransform">
          <Setter.Value><RotateTransform Angle="90" /></Setter.Value>
        </Setter>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="LeadingDock" TargetType="FrameworkElement">
    <Setter Property="DockPanel.Dock" Value="Left" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsVertical}" Value="True">
        <Setter Property="DockPanel.Dock" Value="Top" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="TrailingDock" TargetType="FrameworkElement">
    <Setter Property="DockPanel.Dock" Value="Right" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsVertical}" Value="True">
        <Setter Property="DockPanel.Dock" Value="Bottom" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <DataTemplate x:Key="AST.Bar">
    <Border Background="{StaticResource Face}" BorderBrush="{StaticResource Light}" BorderThickness="0,1,0,0"
            TextElement.FontFamily="Tahoma" TextElement.FontSize="11" TextElement.Foreground="Black">
      <DockPanel LastChildFill="True" Margin="2,0">
        <ContentControl Style="{StaticResource LeadingDock}" Focusable="False"
                        Visibility="{Binding ShowStartButton, Converter={StaticResource BoolToVisible}}">
          <Button Style="{StaticResource ClassicButton}" Command="{Binding StartCommand}" ToolTip="Click here to begin." MinHeight="24">
            <StackPanel Orientation="Horizontal" Margin="2,0,4,0" Style="{StaticResource RotateWhenNarrow}">
              <Grid Width="14" Height="14" Margin="0,0,4,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                <Border Background="#D32F1E" Margin="0,0,1,1" />
                <Border Background="#3FA535" Margin="0,0,0,1" Grid.Column="1" />
                <Border Background="#2A5FC4" Margin="0,0,1,0" Grid.Row="1" />
                <Border Background="#F2C200" Grid.Row="1" Grid.Column="1" />
              </Grid>
              <TextBlock Text="Start" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </ContentControl>

        <!-- The sunken clock area. -->
        <Border Style="{StaticResource TrailingDock}" Margin="2,3" BorderThickness="1,1,0,0" BorderBrush="{StaticResource Shadow}"
                Visibility="{Binding ShowClock, Converter={StaticResource BoolToVisible}}">
          <Border BorderThickness="0,0,1,1" BorderBrush="{StaticResource Light}">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Padding" Value="8,2" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsNarrow}" Value="True">
                    <Setter Property="Padding" Value="1,2" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <!-- The clock stays upright and shrinks to fit a thin side bar. -->
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
              <TextBlock Text="{Binding TimeText}" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Viewbox>
          </Border>
        </Border>

        <!-- Docked after the clock so it sits just inside it. It wraps onto extra rows on a thin side bar. -->
        <ItemsControl Style="{StaticResource TrailingDock}" ItemsSource="{Binding TrayItems}" Focusable="False" VerticalAlignment="Center" HorizontalAlignment="Center"
                      Visibility="{Binding ShowTray, Converter={StaticResource BoolToVisible}}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource ClassicButton}" Command="{Binding InvokeCommand}" ToolTip="{Binding Name}" Width="24" Height="24">
                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="11" HorizontalAlignment="Center" />
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding Items}" Focusable="False" Margin="2,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <eb:TaskPanel IsVertical="{Binding IsVertical}" IsRotated="{Binding RotateLabels}" IsIconsOnly="{Binding IconsOnly}" IconItemLength="32" ItemLength="160" VerticalItemLength="28" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource ClassicButton}" Command="{Binding ActivateCommand}" ToolTip="{Binding Title}">
                <DockPanel Style="{StaticResource RotateTaskContent}">
                  <Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center" />
                  <TextBlock x:Name="Label" Text="{Binding Title}" Margin="4,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                             Visibility="{Binding DataContext.ShowLabels, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisible}}" />
                </DockPanel>
              </Button>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                  <Setter TargetName="Label" Property="FontWeight" Value="Bold" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>
  </DataTemplate>
</ResourceDictionary>
