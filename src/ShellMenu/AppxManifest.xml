<?xml version="1.0" encoding="utf-8"?>
<!--
  A package with no files of its own, pointing at AST's install folder, so that Windows 11 shows AST's items in
  File Explorer's short right-click menu. The OID in Publisher marks it as unsigned, which Windows 11 accepts for
  packages like this. build.ps1 fills in the version and builds ASTMenu.msix from this folder.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  IgnorableNamespaces="uap uap10 rescap com desktop4 desktop5">

  <Identity Name="AST.ExplorerMenu"
            Publisher="CN=AST, OID.2.25.311729368913984317654407730594956997722=1"
            Version="$VERSION$"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>AST</DisplayName>
    <PublisherDisplayName>AST</PublisherDisplayName>
    <Logo>Assets\logo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26200.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>

  <Applications>
    <Application Id="AST" Executable="AST.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements AppListEntry="none" DisplayName="AST" Description="Additional Screen Taskbars"
                          BackgroundColor="transparent" Square150x150Logo="Assets\logo.png" Square44x44Logo="Assets\logo.png" />
      <Extensions>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type=".exe">
              <desktop5:Verb Id="ASTPinTaskbar" Clsid="f745421b-4cc8-4e78-b511-bcec0e45eca8" />
              <desktop5:Verb Id="ASTPinStart" Clsid="a97f2428-9da9-4c86-b05a-f7d8583846ae" />
            </desktop5:ItemType>
            <desktop5:ItemType Type=".lnk">
              <desktop5:Verb Id="ASTPinTaskbar" Clsid="f745421b-4cc8-4e78-b511-bcec0e45eca8" />
              <desktop5:Verb Id="ASTPinStart" Clsid="a97f2428-9da9-4c86-b05a-f7d8583846ae" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="AST File Explorer menu">
              <com:Class Id="f745421b-4cc8-4e78-b511-bcec0e45eca8" Path="ASTMenu.dll" ThreadingModel="STA" />
              <com:Class Id="a97f2428-9da9-4c86-b05a-f7d8583846ae" Path="ASTMenu.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
